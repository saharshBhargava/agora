// Copy to Config/Local.xcconfig. The team's working Google client is inherited
// from Agora.xcconfig; leave these commented unless using a different Cloud project.
// Both values are public client identifiers, not secrets. Override both together.
// AGORA_GOOGLE_IOS_CLIENT_ID = 123456789-example.apps.googleusercontent.com
// AGORA_GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.123456789-example

// The live API URL is inherited from Agora.xcconfig. Uncomment only to use another server.
// Keep the $() so xcconfig doesn't interpret // as a comment.
// AGORA_API_BASE_URL = https:/$()/your-api.example.com
