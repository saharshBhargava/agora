# Copy to .env for local development. Never commit real keys.
AGORA_ENV=dev
AGORA_DATABASE_URL=postgresql://agora:agora-dev-only@127.0.0.1:5433/agora

# replay works offline; use Gemini/Perceptron or a local OpenAI-compatible vision server for real scans.
AGORA_VISION_PROVIDER=replay
AGORA_VISION_FALLBACK=none
# AGORA_PERCEPTRON_API_KEY=
# AGORA_GEMINI_API_KEY=
# Local vision (LM Studio, llama.cpp, etc.): load an image-capable model supporting JSON-schema output.
# AGORA_VISION_PROVIDER=openai-compatible
# AGORA_OPENAI_BASE_URL=http://localhost:1234/v1
# AGORA_OPENAI_MODEL=your-loaded-vision-model
# AGORA_OPENAI_API_KEY=
# Keep AGORA_VISION_FALLBACK=none to avoid sending images to a different provider on failure.

# db (default) keeps frames in Postgres; local needs a persistent disk; s3 needs a bucket.
AGORA_STORAGE_BACKEND=db

# Optional inventory authentication for the native iOS Google sign-in.
# Calendar itself calls Google directly and does not require a backend.
# AGORA_AUTH_MODE=google
# AGORA_GOOGLE_IOS_CLIENT_ID=your-ios-client.apps.googleusercontent.com

# Hosted demo: render.yaml configures these in Render, not in a committed .env.
# AGORA_ENV=demo
# AGORA_AUTH_MODE=google
# AGORA_GOOGLE_IOS_CLIENT_ID=<same public iOS client ID as Config/Agora.xcconfig>
# AGORA_DEMO_GOOGLE_EMAILS=<Google account approved as an OAuth test user>
# AGORA_DEMO_PASSWORD=<Render generates this; keep private>
# AGORA_DEV_JWT_SECRET=<Render generates this; keep private and stable>
# AGORA_SEED_ON_BOOT=true
# AGORA_SEED_NEW_USERS=false
# Browser clients only: JSON array of exact frontend origins; native iOS does not need CORS.
# AGORA_CORS_ORIGINS=["https://your-frontend.example.com"]

# Legacy server-side Calendar OAuth only (not used by the current iOS app).
# Configure all four together if keeping legacy clients enabled.
# AGORA_GOOGLE_CLIENT_ID=your-web-client.apps.googleusercontent.com
# AGORA_GOOGLE_CLIENT_SECRET=
# AGORA_GOOGLE_REDIRECT_URI=https://your-api.example.com/v1/integrations/google/callback
# Generate once with: openssl rand -base64 32. Preserve it across deploys.
# AGORA_GOOGLE_TOKEN_KEY=

# Price watches: the agent model and web search providers are independent.
# Direct HTTPS product pages work without a model.
# Server credentials are separate from the phone's model settings. Never commit real keys.
# AGORA_WATCH_SEARCH_API_KEY=  # defaults to AGORA_GEMINI_API_KEY when unset
# AGORA_WATCH_SEARCH_MODEL=gemini-2.5-flash
# AGORA_WATCH_MODEL_PROVIDER=gemini  # or openai-compatible with AGORA_OPENAI_* above
# AGORA_WATCH_SEARCH_PROVIDERS=["exa","parallel","firecrawl","keenable","tavily","brave"]
# AGORA_WATCH_SEARCH_KEYLESS=true  # Exa/Parallel public MCP and Keenable public REST
# AGORA_WATCH_PROVIDER_REQUEST_BUDGET=12
# AGORA_WATCH_SEARCH_TIMEOUT_S=25
# Optional per-provider credentials; these are not reasoning-model keys.
# AGORA_EXA_API_KEY=
# AGORA_PARALLEL_API_KEY=
# AGORA_FIRECRAWL_API_KEY=
# AGORA_KEENABLE_API_KEY=
# AGORA_TAVILY_API_KEY=
# AGORA_BRAVE_API_KEY=
# AGORA_WATCH_MAX_ACTIVE=25
# AGORA_WATCH_MAX_PAGES=5
# AGORA_WATCH_MAX_SEARCHES=3
# AGORA_WATCH_MAX_TURNS=8
# AGORA_WATCH_TIMEOUT_S=90
# AGORA_WATCH_DAILY_CHECK_CAP=600  # reserves 3 attempts per run, shared per household over 24h
# AGORA_WATCH_DAILY_ALERT_CAP=20  # per-user ceiling in addition to per-watch limits
# APNs alert delivery; inbox remains available without these. PEM value must contain real newlines.
# AGORA_APNS_ENABLED=false
# AGORA_APNS_KEY_ID=
# AGORA_APNS_TEAM_ID=
# AGORA_APNS_PRIVATE_KEY=
# AGORA_APNS_TOPIC=dev.agora.browserchat
